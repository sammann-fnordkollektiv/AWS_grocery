################################################################################
# Stuff
################################################################################

PATH_add scripts
_do_backup_repo
PATH_add .scripts # this one is not git-versioned.

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
nvm use --silent default

################################################################################
# Helper functions
################################################################################

error() { # 1 = message
  printf "\033[31m[FAIL]: ${1}\033[0m\n"
}

success() { # 1 = message
  printf "\033[32m[GOOD]: ${1}\033[0m\n"
}

################################################################################
# AWS Login
################################################################################

export ACCOUNT=304588611738
export AWS_PROFILE="AdministratorAccess-${ACCOUNT}"
export REPO_NAME=grocerymate-app
export REGION="$(aws configure get region --profile "$AWS_PROFILE")"
if aws sts get-caller-identity --profile "$AWS_PROFILE" >/dev/null 2>&1; then
  success 'Already logged in'
else
  error 'Not logged in. Do it now in opened browser.'
  aws sso login --profile "${AWS_PROFILE}" || return 1
fi
export REPO_URI="${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com/${REPO_NAME}"
