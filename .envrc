# common.sh
SCRIPT_DIR="scripts"
source "$SCRIPT_DIR/common.sh"

PATH_add scripts
_do_backup_repo.sh
PATH_add .scripts # this one is not git-versioned.

# cdk
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
nvm use --silent default

common_login_aws
common_set_aws_secrets
common_set_docker_env "backend/"
common_set_ecr_env
